# Copy to .env.local and replace every placeholder with your own credentials.
# Never commit .env.local to GitHub.

# PostgreSQL database (Neon, Supabase or local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Run: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-this-with-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Optional OAuth providers. Add credentials from each provider's developer console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Product data API (the first is preferred, second is fallback)
BAZARDOR_API_URL="https://api.api-store.workers.dev/api/bazardor"
BAZARDOR_API_FALLBACK="https://api.abcz.workers.dev/api/bazardor"
